{
  "expo": {
    "name": "Click Trackz",
    "slug": "cue-tracker",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clicktrackz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kimchankwon.cuetracker",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF6A4D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kimchankwon.cuetracker"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": { "backgroundColor": "#000000" }
        }
      ],
      "expo-secure-store",
      "expo-asset",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "androidForegroundService": false,
          "iosMicrophonePermission": "Click Trackz never records or listens through your microphone. The audio engine that plays the Click, Count and Voice cues also supports recording, so iOS asks every app that uses it to explain microphone access."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "03233056-f381-42e9-bbed-5c4f123f10af"
      }
    },
    "owner": "xtectra",
    "updates": {
      "url": "https://u.expo.dev/03233056-f381-42e9-bbed-5c4f123f10af",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
